{
  "name": "marketing-microservice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "codegen": "convex codegen",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project convex --project tooling",
    "test:watch": "vitest",
    "test:convex": "vitest run --project convex",
    "test:unit": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "dev:auth": "node scripts/dev-auth.mjs",
    "dev:seed": "node scripts/dev-seed.mjs",
    "test:e2e": "playwright test",
    "test:e2e:connections": "playwright test -c playwright.connections.config.mts",
    "test:e2e:connections:cleanup": "node scripts/e2e-connections.mjs cleanup",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.19",
    "@opencoredev/social-sdk": "0.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "^0.0.59",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
