# -----------------------------------------------------------------------------
# Next.js dashboard (.env.local) — PUBLIC values only.
# `npx convex dev` writes these three automatically on first run.
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Optional (Windows): keep Convex temp files on the same drive as the repo.
# CONVEX_TMPDIR=V:\tmp\convex

# DEV ONLY: dashboard JWT minted by `npm run dev:auth setup` (writes it into .env.local).
# Ignored in production builds. While it is set, a development build signs in with it and
# never loads Clerk (local development and the Playwright journeys). Remove it to sign in
# with Clerk locally.
NEXT_PUBLIC_DEV_AUTH_TOKEN=

# Clerk sign-in (standalone SaaS; see docs/api/auth.md "Clerk"). Use the DEVELOPMENT
# instance's keys (pk_test_/sk_test_) locally and for staging. Without a valid publishable
# key the dashboard stays signed out. CLERK_SECRET_KEY is server-only (proxy.ts): in Vercel
# set it as a regular (non-public) environment variable. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# -----------------------------------------------------------------------------
# Secrets DO NOT go in this file.
# Backend secrets are Convex environment variables, set per deployment:
#   npx convex env set NAME value
# They are introduced in later phases (listed here for orientation only):
#   Phase 1  AUTH_ISSUERS (REQUIRED before deploy; JSON array of trusted JWT issuers,
#            "[]" = trust none; see docs/api/auth.md. Dev: npm run dev:auth apply, which
#            only adds/replaces the local dev issuer and keeps the Clerk entry. The dev
#            issuer is refused on every cloud deployment)
#   S1       OAUTH_CONNECTIONS_ENABLED (cloud deployments only: new platform connections
#            are refused unless exactly "true"; set it only after the OAuth callback
#            ownership fix (S2) is deployed and verified. Local deployments ignore it)
#   Phase 4  TOKEN_ENCRYPTION_KEYS (REQUIRED to connect platforms; {"1":"<base64 32 bytes>"};
#            dev: npm run dev:auth encryption-key). Never store it in this file.
#   Phase 8  PROVIDER_MODE (REQUIRED on every cloud deployment: "mock" or "live", exact,
#            lowercase; unset on a cloud deployment or any other value = configuration
#            error, no provider calls; unset on the local backend = mock. See
#            docs/providers/meta.md)
#            META_APP_ID, META_APP_SECRET, META_LOGIN_CONFIG_ID (required when
#            PROVIDER_MODE=live; the app's owning Business portfolio is operator
#            configuration and is never recorded in the repository)
#            META_GRAPH_API_VERSION (optional; overrides the pinned version, e.g. "v26.0")
#   Phase 9  GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (in PROVIDER_MODE=live, setting either
#            enables the real Google Ads provider; incomplete or invalid values fail closed
#            with google_config_invalid). No developer token: they were sunset on 2026-09-09
#            and API access belongs to the Google Cloud project that owns the OAuth client.
#            See docs/providers/google-ads.md "API access")
#            GOOGLE_ADS_API_VERSION (optional; overrides the pinned version, e.g. "v25")
#   Phase 10 INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET (Instagram Login, organic Instagram only;
#            in PROVIDER_MODE=live, setting either enables the real Instagram spec/provider;
#            invalid values fail closed with instagram_config_invalid. See
#            docs/providers/instagram.md)
#   ADR 0016 YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET (organic YouTube; a Google OAuth web
#            client of its OWN Google Cloud project, never the Google Ads client: a client id
#            equal to GOOGLE_CLIENT_ID is refused as youtube_config_invalid. In
#            PROVIDER_MODE=live, setting either enables the real YouTube spec/provider. Redirect
#            URI: <CONVEX_SITE_URL>/oauth/callback. See docs/providers/youtube.md)
#   Phase 11 META_WEBHOOK_VERIFY_TOKEN
# -----------------------------------------------------------------------------
