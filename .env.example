# -----------------------------------------------------------------------------
# Next.js dashboard (.env.local) — PUBLIC values only.
# `npx convex dev` writes these three automatically on first run.
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Optional (Windows): keep Convex temp files on the same drive as the repo.
# CONVEX_TMPDIR=V:\tmp\convex

# DEV ONLY: dashboard JWT minted by `npm run dev:auth setup` (writes it into .env.local).
# Ignored in production builds. Never put a real parent-app token here.
NEXT_PUBLIC_DEV_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Secrets DO NOT go in this file.
# Backend secrets are Convex environment variables, set per deployment:
#   npx convex env set NAME value
# They are introduced in later phases (listed here for orientation only):
#   Phase 1  AUTH_ISSUERS (REQUIRED before deploy; JSON array of trusted JWT issuers,
#            "[]" = trust none; see docs/api/auth.md. Dev: npm run dev:auth apply)
#   Phase 4  TOKEN_ENCRYPTION_KEYS (REQUIRED to connect platforms; {"1":"<base64 32 bytes>"};
#            dev: npm run dev:auth encryption-key). Never store it in this file.
#   Phase 8  PROVIDER_MODE (REQUIRED on every cloud deployment: "mock" or "live", exact,
#            lowercase; unset on a cloud deployment or any other value = configuration
#            error, no provider calls; unset on the local backend = mock. See
#            docs/providers/meta.md)
#            META_APP_ID, META_APP_SECRET, META_LOGIN_CONFIG_ID (required when
#            PROVIDER_MODE=live; the app's owning Business portfolio is operator
#            configuration and is never recorded in the repository)
#            META_GRAPH_API_VERSION (optional; overrides the pinned version, e.g. "v26.0")
#   Phase 9  GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_ADS_DEVELOPER_TOKEN (in
#            PROVIDER_MODE=live, setting any of them enables the real Google Ads provider;
#            incomplete or invalid values fail closed with google_config_invalid. See
#            docs/providers/google-ads.md)
#            GOOGLE_ADS_API_VERSION (optional; overrides the pinned version, e.g. "v25")
#   Phase 10 INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET (Instagram Login, organic Instagram only;
#            in PROVIDER_MODE=live, setting either enables the real Instagram spec/provider;
#            invalid values fail closed with instagram_config_invalid. See
#            docs/providers/instagram.md)
#   Phase 11 META_WEBHOOK_VERIFY_TOKEN
# -----------------------------------------------------------------------------
